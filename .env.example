# Required: Claude API key (server only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Required for the paywall: Stripe TEST secret key (sk_test_...)
STRIPE_SECRET_KEY=
# Required for the paywall: random string, 32+ characters, used to sign unlock tokens
UNLOCK_SECRET=
# Optional: public URL used for Stripe redirects (defaults to the request origin)
NEXT_PUBLIC_APP_URL=
